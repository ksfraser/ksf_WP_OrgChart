{
    "name": "ksfraser/ksf_wp_orgchart",
    "description": "WordPress OrgChart Adapter - Interactive organizational hierarchy visualization",
    "type": "library",
    "license": "GPL-3.0",
    "require": {
        "php": "^7.3",
        "ksfraser/ksf-orgchart": "*",
        "ksfraser/ksf-hrm": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Ksfraser\\WP\\OrgChart\\": "src/Ksfraser/WP/OrgChart/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ksfraser\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../ksf_OrgChart"
        },
        {
            "type": "path",
            "url": "../ksf_HRM"
        }
    ]
}